{
    "name": "charm/csv",
    "description": "Fast RFC 4180 CSV encoding and decoding in PHP: a readonly Format, an Encoder and an incremental Decoder that accepts input in arbitrary chunks.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "keywords": [
        "csv",
        "rfc4180",
        "tsv",
        "parser",
        "encoder",
        "decoder",
        "incremental"
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Charm\\Csv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Charm\\Csv\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
